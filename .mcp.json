{
  "mcpServers": {
    "skel": {
      "type": "stdio",
      "command": "npx",
      "args": ["--yes", "skel-mcp@0.2.0"]
    },
    "ts-lsp-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "ts-lsp-mcp", "serve", "--stdio"]
    },
    "ttsc-graph": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@ttsc/graph"]
    },
    "npm-helper": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@pinkpixel/npm-helper-mcp"]
    },
    "nodejs-debugger": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@hyperdrive-eng/mcp-nodejs-debugger"]
    }
  }
}
