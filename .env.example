# Copy to .env and adjust. All values optional — sane defaults are built in.
# The system is PUBLIC-MARKET-DATA ONLY: no API keys are needed or used.

# LLM
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=openbmb/minicpm5-2b
AGENT_MAX_STEPS=12
AGENT_NUM_CTX=8192
AGENT_TEMPERATURE=0.2

# Universe (USDT-M perpetuals only)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Paper account
INITIAL_BALANCE=10000
MAX_LEVERAGE=3
MAX_POSITION_NOTIONAL_PCT=25
MAX_PORTFOLIO_NOTIONAL_PCT=80
MAX_RISK_PER_TRADE_PCT=1.5
DAILY_LOSS_LIMIT_PCT=5
MAKER_FEE_BPS=2
TAKER_FEE_BPS=5

# Event triggers
KLINE_TRIGGER_INTERVALS=5m,15m
LIQUIDATION_NOTIONAL_USD=500000
CYCLE_MINUTES=15
COOLDOWN_SECONDS=45
